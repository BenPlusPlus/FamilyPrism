    "remix": "3.2.0",
    "tsx": "4.23.15",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
