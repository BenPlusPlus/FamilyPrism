<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\prismshared\prismshared.csproj" />
  </ItemGroup>

  <Target Name="CopyBundledServiceFiles" AfterTargets="Build">
    <MSBuild Projects="..\prismsvc\prismsvc.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="..\prismupdate\prismupdate.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <BundledServiceFiles Include="..\prismsvc\bin\$(Configuration)\net10.0-windows\**\*.*" />
      <UpdateHelperFiles Include="..\prismupdate\bin\$(Configuration)\net10.0-windows\prismupdate.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BundledServiceFiles)"
      DestinationFiles="@(BundledServiceFiles->'$(OutDir)Service\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(UpdateHelperFiles)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishBundledService" AfterTargets="Publish" Condition="'$(PublishBundledService)' != 'false'">
    <PropertyGroup>
      <_ServicePublishDir>$([MSBuild]::EnsureTrailingSlash($(PublishDir)))Service</_ServicePublishDir>
    </PropertyGroup>
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\prismsvc\prismsvc.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(_ServicePublishDir);PublishBundledService=false;PublishUpdateHelper=false;PublishInstaller=false;PublishClientZip=false" />
  </Target>

  <Target
    Name="PublishUpdateHelper"
    AfterTargets="PublishBundledService"
    Condition="'$(PublishUpdateHelper)' != 'false' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_HelperPublishDir>$([MSBuild]::NormalizeDirectory($([MSBuild]::EnsureTrailingSlash($(PublishDir)))_prismupdate))</_HelperPublishDir>
    </PropertyGroup>
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\prismupdate\prismupdate.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(_HelperPublishDir);PublishUpdateHelper=false;PublishBundledService=false;PublishInstaller=false;PublishClientZip=false" />
  </Target>

  <Target
    Name="CopyPublishedUpdateHelper"
    AfterTargets="PublishUpdateHelper"
    Condition="'$(PublishUpdateHelper)' != 'false' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_HelperPublishDir>$([MSBuild]::NormalizeDirectory($([MSBuild]::EnsureTrailingSlash($(PublishDir)))_prismupdate))</_HelperPublishDir>
    </PropertyGroup>
    <Error
      Text="Published update helper was not found at '$(_HelperPublishDir)prismupdate.exe'."
      Condition="!Exists('$(_HelperPublishDir)prismupdate.exe')" />
    <ItemGroup>
      <_HelperFiles Include="$(_HelperPublishDir)prismupdate.exe" />
      <_HelperFiles Include="$(_HelperPublishDir)prismupdate.dll" />
      <_HelperFiles Include="$(_HelperPublishDir)prismupdate.deps.json" />
      <_HelperFiles Include="$(_HelperPublishDir)prismupdate.runtimeconfig.json" />
      <_HelperFiles Include="$(_HelperPublishDir)prismupdate.pdb" Condition="Exists('$(_HelperPublishDir)prismupdate.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_HelperFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(_HelperPublishDir)" />
  </Target>

  <Target
    Name="PackageClientZip"
    AfterTargets="CopyPublishedUpdateHelper"
    Condition="'$(PublishClientZip)' != 'false' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_ClientZipDir>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)..\artifacts))</_ClientZipDir>
      <_PackageClientZipScript>$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory)..\package-client-zip.ps1))</_PackageClientZipScript>
      <_PublishDirForZip>$([System.String]::Copy('$(PublishDir)').TrimEnd('\'))</_PublishDirForZip>
      <_ClientZipPath>$([MSBuild]::NormalizePath($(_ClientZipDir)FamilyPrism-$(Version)-$(RuntimeIdentifier).zip))</_ClientZipPath>
    </PropertyGroup>
    <MakeDir Directories="$(_ClientZipDir)" />
    <Exec
      StandardOutputImportance="High"
      Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(_PackageClientZipScript)&quot; -PublishDir &quot;$(_PublishDirForZip)&quot; -ZipPath &quot;$(_ClientZipPath)&quot; -Version &quot;$(Version)&quot;" />
  </Target>

  <Target
    Name="BuildInnoInstaller"
    AfterTargets="CopyPublishedUpdateHelper"
    Condition="'$(Configuration)' == 'Release' and '$(PublishInstaller)' != 'false' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_InstallerOutputDir>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)..\artifacts\installer))</_InstallerOutputDir>
      <_CompileInstallerScript>$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory)..\installer\compile.ps1))</_CompileInstallerScript>
      <_PublishDirForInstaller>$([System.String]::Copy('$(PublishDir)').TrimEnd('\'))</_PublishDirForInstaller>
      <_InstallerOutputDirForScript>$([System.String]::Copy('$(_InstallerOutputDir)').TrimEnd('\'))</_InstallerOutputDirForScript>
    </PropertyGroup>
    <MakeDir Directories="$(_InstallerOutputDir)" />
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(_CompileInstallerScript)&quot; -PublishDir &quot;$(_PublishDirForInstaller)&quot; -OutputDir &quot;$(_InstallerOutputDirForScript)&quot; -Version &quot;$(Version)&quot;" />
  </Target>

</Project>